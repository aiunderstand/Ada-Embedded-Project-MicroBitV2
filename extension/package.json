{
  "name": "microbit-flasher",
  "displayName": "micro:bit v2 Flasher",
  "description": "Flash the micro:bit v2 over WebUSB from inside VS Code, including Codespaces",
  "version": "0.1.6",
  "publisher": "AIUnderstand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiunderstand/Ada-Embedded-Project-MicroBitV2.git"
  },
  "homepage": "https://github.com/aiunderstand/Ada-Embedded-Project-MicroBitV2#readme",
  "keywords": [
    "micro:bit",
    "microbit",
    "webusb",
    "ada",
    "codespaces",
    "flash"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "browser": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "microbit.connect",
        "title": "micro:bit: Connect board",
        "category": "micro:bit",
        "icon": "$(plug)"
      },
      {
        "command": "microbit.disconnect",
        "title": "micro:bit: Disconnect board",
        "category": "micro:bit",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "microbit.flash",
        "title": "micro:bit: Build and flash",
        "category": "micro:bit",
        "icon": "$(zap)"
      },
      {
        "command": "microbit.status",
        "title": "micro:bit: Show connection status",
        "category": "micro:bit"
      },
      {
        "command": "microbit.serial",
        "title": "micro:bit: Open serial console",
        "category": "micro:bit"
      }
    ],
    "keybindings": [
      {
        "command": "microbit.flash",
        "key": "ctrl+alt+f"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "microbit",
          "title": "micro:bit",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "microbit": [
        {
          "type": "webview",
          "id": "microbitSerial",
          "name": "Serial",
          "icon": "$(circuit-board)",
          "contextualTitle": "micro:bit serial"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "microbit.connect",
          "when": "view == microbitSerial && !microbit.connected",
          "group": "navigation@1"
        },
        {
          "command": "microbit.disconnect",
          "when": "view == microbitSerial && microbit.connected",
          "group": "navigation@1"
        },
        {
          "command": "microbit.flash",
          "when": "view == microbitSerial",
          "group": "navigation@2"
        }
      ]
    }
  }
}
