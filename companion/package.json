{
  "name": "microbit-companion",
  "displayName": "micro:bit Companion (Codespaces)",
  "description": "Runs next to the board: installs the micro:bit v2 Flasher into your browser in a Codespace, connects gdb to it for F5, and on your own machine lists the boards and relays their serial output",
  "version": "0.1.3",
  "publisher": "AIUnderstand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiunderstand/Ada-Embedded-Project-MicroBitV2.git"
  },
  "homepage": "https://github.com/aiunderstand/Ada-Embedded-Project-MicroBitV2#readme",
  "keywords": [
    "micro:bit",
    "microbit",
    "codespaces",
    "ada",
    "gdb",
    "debug"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebugResolve:cortex-debug"
  ],
  "contributes": {
    "commands": [
      {
        "command": "microbit.companion.install",
        "title": "micro:bit: Install the flasher in this browser",
        "category": "micro:bit"
      },
      {
        "command": "microbit.companion.ping",
        "title": "micro:bit: (internal) companion ping",
        "category": "micro:bit"
      },
      {
        "command": "microbit.companion.serial",
        "title": "micro:bit: (internal) serial request",
        "category": "micro:bit"
      },
      {
        "command": "microbit.companion.boards",
        "title": "micro:bit: (internal) boards on this machine",
        "category": "micro:bit"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "microbit.companion.ping",
          "when": "false"
        },
        {
          "command": "microbit.companion.serial",
          "when": "false"
        },
        {
          "command": "microbit.companion.boards",
          "when": "false"
        }
      ]
    }
  }
}
