{
    "name": "Ada Embedded (Micro:Bit v2) with Alire",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.13"
        }
    },

    "containerUser": "root",
    "remoteUser": "root",

    // USB passthrough only ever works on a Linux host. Docker Desktop on macOS
    // and Windows cannot pass USB to the Linux VM, and a cloud Codespace has no
    // USB at all -- those can build, but you flash by dragging build/main.hex
    // onto the MICROBIT drive. See the README.
    "runArgs": [
        "--privileged",
        "--device-cgroup-rule=c 189:* rmw"
    ],
    "mounts": [
        "source=/dev,target=/dev,type=bind",
        "source=/run/udev,target=/run/udev,type=bind,readonly"
    ],

    // onCreateCommand runs before the workspace content is guaranteed to be
    // final; updateContentCommand is the step that also runs during Codespaces
    // prebuilds, which is where the submodule must be fetched.
    "onCreateCommand": "bash .devcontainer/setup.sh",
    "updateContentCommand": "git config --global --add safe.directory '*' && git submodule update --init --recursive",
    "postCreateCommand": "python3 tools/mb.py doctor",

    // The toolchain is symlinked into /usr/local/bin by setup.sh, so PATH needs
    // no per-install hashed directory and nothing has to source a shell rc.
    "remoteEnv": {
        "PATH": "/usr/local/bin:${containerEnv:PATH}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "AdaCore.ada",
                "EditorConfig.EditorConfig",
                "ms-vscode.cpptools",
                "ms-vscode.vscode-serial-monitor",
                "awsxxf.serialterminal",
                "eclipse-cdt.serial-monitor",
                "mcu-debug.debug-tracker-vscode",
                "marus25.cortex-debug"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true
                // Deliberately no "ada.projectFile": it would override the
                // committed .als.json in every Codespace and stop
                // "mb.py als --use <project>" from switching projects.
            }
        }
    }
}
