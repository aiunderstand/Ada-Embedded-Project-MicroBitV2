{
    "name": "Ada Embedded (Micro:Bit v2)",

    // Pull the prebuilt toolchain image; do not build anything here.
    //
    // An earlier version used "build" + "cacheFrom" pointing at this same image,
    // on the theory that it would fall back to a local build if the image were
    // ever unavailable. Measured in a real Codespace, that never hit the cache
    // and took 3m 4s, re-downloading the whole toolchain:
    //
    //   #6  importing cache manifest from ghcr.io/...   DONE 1.7s
    //   #7  RUN apt-get update ...                      DONE 29.2s   <- rebuilt
    //   #11 RUN alr toolchain --select ...              DONE 78.9s   <- re-downloaded
    //
    // Two reasons it cannot work. The dev container CLI does not build this
    // Dockerfile as written -- it rewrites it as "Dockerfile-with-features",
    // injecting _DEV_CONTAINERS_BASE_IMAGE and a renamed target stage, so the
    // layer hashes never match. And --cache-from against a plain image needs
    // inline cache metadata the published image does not carry.
    //
    // The Dockerfile stays in this folder: it is the source of this image, and
    // you can still build it by hand. The publishing workflow asserts the image
    // is anonymously pullable, so a failure there is loud rather than silent.
    "image": "ghcr.io/aiunderstand/ada-microbit-toolchain:gnat-15.1.2",

    "remoteUser": "vscode",

    // "mb.py serve" publishes the flasher here. Forwarded ports are served over
    // HTTPS on *.app.github.dev, which is a secure context -- WebUSB requires
    // one, so flashing works straight from a Codespace with no download step.
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "micro:bit flasher",
            // Not "openPreview": VS Code's Simple Browser is an iframe and
            // WebUSB does not work there. It has to be a real browser tab.
            "onAutoForward": "notify"
        }
    },

    // USB passthrough only works on a Linux host. Docker Desktop on macOS and
    // Windows cannot pass USB to its Linux VM, and a Codespace has no USB at
    // all -- those build here and flash from the browser. See setup/.
    "runArgs": [
        "--privileged",
        "--device-cgroup-rule=c 189:* rmw"
    ],
    "mounts": [
        "source=/dev,target=/dev,type=bind",
        "source=/run/udev,target=/run/udev,type=bind,readonly"
    ],

    // updateContentCommand also runs during Codespaces prebuilds, which is
    // where the submodule has to be fetched. safe.directory is needed because
    // the workspace is checked out by a different uid than the container user.
    "updateContentCommand": "git config --global --add safe.directory '*' && git submodule update --init --recursive",

    // Tells the student straight away whether their environment is usable.
    "postCreateCommand": "python3 tools/mb.py doctor",


    "customizations": {
        "vscode": {
            "extensions": [
                "AdaCore.ada",
                "EditorConfig.EditorConfig",
                "ms-vscode.cpptools",
                "ms-vscode.vscode-serial-monitor",
                "awsxxf.serialterminal",
                "eclipse-cdt.serial-monitor",
                "mcu-debug.debug-tracker-vscode",
                "marus25.cortex-debug"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true
                // Deliberately no "ada.projectFile": a VS Code setting in any
                // scope overrides the committed .als.json and would stop
                // "mb.py als --use <project>" from switching projects.
            },
            // Open the file the student is meant to edit, so a fresh Codespace
            // lands on their program rather than an empty editor.
            "openFiles": ["Code/src/main.adb"]
        }
    }
}
