{
    // One configuration for every project. Whatever you built last is staged at
    // build/main.elf, so F5 always debugs the thing you just built and this file
    // never needs editing.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (PyOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/main.elf",
            "servertype": "pyocd",
            "targetId": "nrf52833",
            "preLaunchTask": "Build",
            "showDevDebugOutput": "vscode"
            // "runToEntryPoint": "main"  // uncomment to break on start
        }
    ]
}
